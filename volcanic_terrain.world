<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="volcanic_world">
    
    <!-- World physics settings for gz sim -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics plugin for new Gazebo -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>

    <!-- User commands plugin -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Scene broadcaster -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Contact system -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>

    <!-- Global light source -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Atmospheric settings for volcanic environment -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Volcanic surface model embedded directly -->
    <model name="volcanic_surface">
      
      <!-- Main volcanic ground plane -->
      <link name="volcanic_ground">
        <pose>0 0 0 0 0 0</pose>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>50 50 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.15 1</ambient>
            <diffuse>0.3 0.2 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>50 50 1</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Large volcanic rocks -->
      <link name="large_rock_1">
        <pose>5.2 3.8 0.6 0.1 0.2 0.3</pose>
        <visual name="rock1_visual">
          <geometry>
            <box>
              <size>2.5 1.8 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.15 0.1 1</ambient>
            <diffuse>0.25 0.15 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="rock1_collision">
          <geometry>
            <box>
              <size>2.5 1.8 1.2</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="large_rock_2">
        <pose>-7.5 -4.2 0.9 0.15 -0.1 0.8</pose>
        <visual name="rock2_visual">
          <geometry>
            <box>
              <size>3.1 2.2 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.18 0.12 1</ambient>
            <diffuse>0.28 0.18 0.12 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="rock2_collision">
          <geometry>
            <box>
              <size>3.1 2.2 1.8</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="large_rock_3">
        <pose>8.7 -6.1 1.25 0.3 0.2 -0.4</pose>
        <visual name="rock3_visual">
          <geometry>
            <cylinder>
              <radius>1.8</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.22 0.12 0.08 1</ambient>
            <diffuse>0.22 0.12 0.08 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="rock3_collision">
          <geometry>
            <cylinder>
              <radius>1.8</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Medium rocks -->
      <link name="medium_rock_1">
        <pose>2.3 -8.5 0.4 0.1 0.3 0.6</pose>
        <visual name="med_rock1_visual">
          <geometry>
            <box>
              <size>1.5 1.2 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.22 0.16 1</ambient>
            <diffuse>0.32 0.22 0.16 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="med_rock1_collision">
          <geometry>
            <box>
              <size>1.5 1.2 0.8</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="medium_rock_2">
        <pose>-3.7 7.2 0.65 0.2 -0.15 1.3</pose>
        <visual name="med_rock2_visual">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.29 0.19 0.13 1</ambient>
            <diffuse>0.29 0.19 0.13 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="med_rock2_collision">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>1.3</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Small scattered stones -->
      <link name="small_stone_1">
        <pose>1.2 5.7 0.15 0.1 0.2 0.8</pose>
        <visual name="stone1_visual">
          <geometry>
            <box>
              <size>0.6 0.4 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.35 0.25 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="stone1_collision">
          <geometry>
            <box>
              <size>0.6 0.4 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="small_stone_2">
        <pose>-1.8 -2.3 0.25 0.15 -0.1 1.1</pose>
        <visual name="stone2_visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.33 0.23 0.17 1</ambient>
            <diffuse>0.33 0.23 0.17 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="stone2_collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Volcanic crater -->
      <link name="crater_rim_1">
        <pose>-12.0 -10.0 0.4 0.1 0.05 0</pose>
        <visual name="crater_visual">
          <geometry>
            <cylinder>
              <radius>4.0</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.1 0.05 1</ambient>
            <diffuse>0.2 0.1 0.05 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="crater_collision">
          <geometry>
            <cylinder>
              <radius>4.0</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

      <!-- Uneven terrain patches -->
      <link name="terrain_bump_1">
        <pose>15.0 5.0 0.75 0.1 0.2 0.15</pose>
        <visual name="bump1_visual">
          <geometry>
            <box>
              <size>6.0 4.0 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.27 0.17 0.12 1</ambient>
            <diffuse>0.27 0.17 0.12 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="bump1_collision">
          <geometry>
            <box>
              <size>6.0 4.0 1.5</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="terrain_bump_2">
        <pose>-15.0 12.0 1.0 0.15 -0.1 -0.3</pose>
        <visual name="bump2_visual">
          <geometry>
            <cylinder>
              <radius>3.5</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.24 0.14 0.09 1</ambient>
            <diffuse>0.24 0.14 0.09 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="bump2_collision">
          <geometry>
            <cylinder>
              <radius>3.5</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>

    </model>

  </world>
</sdf>
